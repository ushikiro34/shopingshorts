# 쿠팡 파트너스 API
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# Supabase (DB / Storage)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 네이버 쇼핑검색 오픈API (쿠팡 API가 아님 — 수동 등록 상품의 대표 이미지 자동 채움용, 크롤링 아님)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Anthropic (Phase 2 — 후기 분석, 대본 생성)
ANTHROPIC_API_KEY=

# Phase 3 — TTS (기본값 edge, 키 불필요). ElevenLabs로 바꾸려면 TTS_PROVIDER=elevenlabs +
# 아래 두 값 설정 (단, 무료 플랜은 라이브러리 보이스를 API로 못 씀 — docs/01_plan.md 참조)
TTS_PROVIDER=edge
EDGE_TTS_VOICE=ko-KR-SunHiNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Gemini(나노바나나) 이미지 생성 — 씬의 화면 연출에 맞춰 실사 상품 사진을 참고 이미지로
# 넣어 새 이미지를 만든다 (app/media/image_generator.py). 없으면 실사 사진을 그대로 쓴다.
GEMINI_API_KEY=

# Phase 4 이후에서 사용, interfaces.md 6번 전체 목록과 맞춰 미리 선언해 둔다.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
DEFAULT_HOLD_MINUTES=240
STORAGE_BUCKET=
POLICY_CHECK_SECRET=
SESSION_SECRET=
